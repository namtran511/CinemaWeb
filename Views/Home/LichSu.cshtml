@using Microsoft.AspNetCore.Http
@model IEnumerable<CinemaWeb.Models.Ve>
@{
    ViewData["Title"] = "Lịch Sử Đặt Vé";
    // Tra cứu danh sách suất chiếu từ ViewBag
    var dsSuat = ViewBag.DsSuatChieu as List<CinemaWeb.Models.SuatChieu>;
}

<div class="container mt-5 px-lg-5" style="min-height: 80vh;">
    <div class="d-flex align-items-center mb-4">
        <h2 class="text-warning fw-bold"><i class="bi bi-ticket-detailed-fill me-2"></i> LỊCH SỬ ĐẶT VÉ</h2>
    </div>

    <div class="card bg-dark border-secondary shadow-lg">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead class="table-danger">
                    <tr>
                        <th class="ps-4">Mã Vé</th>
                        <th>Tên Phim</th>
                        <th class="text-info">Suất Chiếu</th>
                        <th>Số Ghế</th>
                        <th class="text-warning">Combo Bắp Nước</th> @* Thêm cột Bắp Nước *@
                        <th>Thời Gian Đặt</th>
                        <th>Tổng Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var v in Model)
                        {
                            // Tìm giờ chiếu tương ứng
                            var suat = dsSuat?.FirstOrDefault(s => s.MaSuat == v.SuatChieuId);
                            var gioChieu = suat != null ? suat.ThoiGian : "Không rõ";
                            var phongChieu = suat != null ? suat.PhongChieu : 0;

                            <tr>
                                <td class="ps-4 fw-bold text-secondary">#@v.MaVe</td>
                                <td class="fw-bold text-white">@v.TenPhim</td>

                                @* HIỂN THỊ GIỜ CHIẾU *@
                                <td>
                                    <span class="badge bg-info text-dark">@gioChieu</span>
                                    @if (phongChieu > 0)
                                    {
                                        <span class="badge bg-secondary ms-1">Phòng @phongChieu</span>
                                    }
                                </td>

                                <td><span class="badge bg-secondary">@v.TenGhe</span></td>

                                @* HIỂN THỊ COMBO BẮP NƯỚC *@
                                <td class="small">
                                    @if (string.IsNullOrEmpty(v.BapNuoc))
                                    {
                                        <span class="text-muted">Không kèm bắp nước</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning fw-bold">@v.BapNuoc</span>
                                    }
                                </td>

                                <td class="small text-secondary">@v.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>

                                <td class="text-warning fw-bold">@v.TongTien.ToString("N0") VNĐ</td>

                                <td class="text-center">
                                    <div class="d-flex flex-column align-items-center">
                                        @if (v.TrangThai == "Chờ thanh toán")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 mb-1">
                                                <i class="bi bi-hourglass-split"></i> Chờ thanh toán
                                            </span>

                                            @* Nút Duyệt vé chỉ hiện cho Admin hoặc Quản lý *@
                                            var role = Context.Session.GetString("UserRole");
                                            if (role == "Quản Lý" || role == "Admin")
                                            {
                                                <a asp-action="HoanTatThanhToan" asp-route-id="@v.MaVe"
                                                   class="btn btn-sm btn-outline-success py-0 fw-bold"
                                                   style="font-size: 0.7rem;"
                                                   title="Xác nhận đã nhận tiền">
                                                    Duyệt vé
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-circle-fill"></i> Đã thanh toán
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">Chưa có lịch sử đặt vé nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a href="/" class="btn btn-outline-light rounded-pill px-4 shadow">
            <i class="bi bi-arrow-left"></i> Quay lại Trang chủ
        </a>
    </div>
</div>

<style>
    .table-dark {
        background-color: #1a1a1a !important;
    }

    .table-hover tbody tr:hover {
        background-color: #252525 !important;
        transition: 0.3s;
    }

    .badge {
        font-size: 0.8rem;
    }

    .table thead th {
        border: none;
        padding: 15px 10px;
        font-size: 0.9rem;
        text-transform: uppercase;
    }
</style>