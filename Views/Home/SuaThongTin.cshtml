@model CinemaWeb.Models.NguoiDung
<div class="container mt-5 text-white">
    <h2 class="text-danger fw-bold">CHỈNH SỬA THÔNG TIN CÁ NHÂN</h2>
    <form asp-action="SuaThongTin" method="post" class="mt-4 p-4 bg-dark rounded border border-secondary shadow">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Họ tên</label>
            <input asp-for="HoTen" class="form-control bg-black text-white border-secondary" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control bg-black text-white border-secondary" />
        </div>
        <div class="mb-3">
            <label class="form-label">Số điện thoại</label>
            <input asp-for="SoDienThoai" class="form-control bg-black text-white border-secondary" />
        </div>
        <div class="mb-3">
            <label class="form-label">Mật khẩu mới (để trống nếu không đổi)</label>
            <input name="MatKhau" type="password" class="form-control bg-black text-white border-secondary" />
        </div>
        <button type="submit" class="btn btn-danger fw-bold w-100">LƯU THAY ĐỔI</button>
    </form>
</div>