@model IEnumerable<CinemaWeb.Models.Ve>

<div class="container mt-5">
    <h2 class="text-warning fw-bold mb-4">SYSTEM ADMIN: QUẢN LÝ VÉ</h2>

    <div class="card bg-dark border-secondary shadow">
        <table class="table table-dark table-hover mb-0">
            <thead class="table-warning">
                <tr>
                    <th>Mã Vé</th>
                    <th>Phim</th>
                    <th>Ghế</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>#@v.MaVe</td>
                        <td>@v.TenPhim</td>
                        <td>@v.TenGhe</td>
                        <td>@v.TongTien.ToString("N0") đ</td>
                        <td>
                            <span class="badge @(v.TrangThai == "Chờ thanh toán" ? "bg-warning text-dark" : "bg-success")">
                                @v.TrangThai
                            </span>
                        </td>
                        <td>
                            @if (v.TrangThai == "Chờ thanh toán")
                            {
                                <a asp-action="HoanTatThanhToan" asp-route-id="@v.MaVe" class="btn btn-sm btn-success">
                                    Duyệt ngay
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
