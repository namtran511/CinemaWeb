@model List<CinemaWeb.Models.Phim>
@{
    ViewData["Title"] = "Gợi Ý Phim";
}

<style>
    .suggestion-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        border: 1px solid rgba(255,255,255,0.08);
        overflow: hidden;
    }

    .suggestion-card:hover {
        transform: scale(1.05);
        box-shadow: 0 18px 30px rgba(229, 9, 20, 0.25);
        border-color: rgba(229, 9, 20, 0.7);
    }

    .suggestion-card img {
        transition: transform 0.25s ease;
    }

    .suggestion-card:hover img {
        transform: scale(1.03);
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning fw-bold mb-0"><i class="bi bi-lightbulb-fill me-2"></i>Gợi Ý Phim Cho Bạn</h2>
        <a asp-action="Index" class="btn btn-outline-light btn-sm">Quay lại trang chủ</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4">
            @foreach (var phim in Model)
            {
                <div class="col">
                    <div class="card suggestion-card bg-dark h-100 shadow-sm">
                        <div class="position-relative">
                            <img src="~/images/@phim.HinhAnh" class="card-img-top" alt="@phim.TenPhim" style="height: 290px; object-fit: cover;" onerror="this.src='/images/no-image.jpg';">
                            <span class="position-absolute top-0 end-0 badge bg-danger m-2">@phim.ThoiLuong phút</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="text-white fw-bold mb-2">@phim.TenPhim</h6>
                            <p class="text-secondary small mb-3">@phim.MoTa</p>
                            <div class="mt-auto">
                                <a asp-action="ChiTiet" asp-route-id="@phim.MaPhim" class="btn btn-danger w-100">Đặt vé ngay</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-secondary">Hiện chưa có phim nào để gợi ý.</div>
    }
</div>
