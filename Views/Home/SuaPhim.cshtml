@model CinemaWeb.Models.Phim
<div class="container mt-5 text-white">
    <h2 class="text-warning fw-bold">CHỈNH SỬA PHIM</h2>
    <form asp-action="SuaPhim" method="post" enctype="multipart/form-data" class="mt-4 p-4 bg-dark rounded border border-secondary">
        <input type="hidden" asp-for="MaPhim" />
        <div class="mb-3">
            <label class="form-label">Tên Phim</label>
            <input asp-for="TenPhim" class="form-control bg-black text-white border-secondary" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Mô tả</label>
            <textarea asp-for="MoTa" class="form-control bg-black text-white border-secondary" rows="3"></textarea>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Thời lượng (Phút)</label>
                <input asp-for="ThoiLuong" type="number" class="form-control bg-black text-white border-secondary" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Trạng thái</label>
                <select asp-for="TrangThai" class="form-select bg-black text-white border-secondary">
                    <option value="Đang Chiếu">Đang Chiếu</option>
                    <option value="Sắp Chiếu">Sắp Chiếu</option>
                </select>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Link Trailer (YouTube)</label>
            <input asp-for="TrailerUrl" class="form-control bg-black text-white border-secondary" />
        </div>
        <div class="mb-3">
            <label class="form-label">Hình ảnh (Để trống nếu giữ ảnh cũ)</label>
            <input type="file" name="FileAnh" class="form-control bg-black text-white border-secondary" />
        </div>
        <button type="submit" class="btn btn-warning fw-bold w-100 mt-3 text-dark">LƯU THÔNG TIN</button>
        <a href="/Home/AdminPhim" class="btn btn-outline-secondary w-100 mt-2">Hủy bỏ</a>
    </form>
</div>