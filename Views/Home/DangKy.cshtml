@model CinemaWeb.Models.NguoiDung

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="card bg-dark text-white p-4 mx-auto shadow-lg border-secondary" style="max-width: 450px; margin-top: 80px; border-radius: 15px;">
    <h3 class="text-center text-danger fw-bold mb-4">ĐĂNG KÝ TÀI KHOẢN</h3>

    <form asp-action="DangKy" method="post">
        <div class="mb-3">
            <label class="form-label text-warning small fw-bold"><i class="bi bi-person-badge me-1"></i> HỌ VÀ TÊN:</label>
            <input type="text" name="HoTen" class="form-control bg-secondary text-white border-0 py-2" placeholder="VD: Sơn bé tý" required>
        </div>

        <div class="mb-3">
            <label class="form-label text-warning small fw-bold"><i class="bi bi-person-fill me-1"></i> TÊN ĐĂNG NHẬP (TÀI KHOẢN):</label>
            <input type="text" name="TenDangNhap" class="form-control bg-secondary text-white border-0 py-2" placeholder="sonbety..." required>
        </div>

        <div class="mb-3">
            <label class="form-label text-warning small fw-bold"><i class="bi bi-lock-fill me-1"></i> MẬT KHẨU:</label>
            <input type="password" name="MatKhau" class="form-control bg-secondary text-white border-0 py-2" placeholder="Nhập mật khẩu..." required>
        </div>

        <input type="hidden" name="VaiTro" value="Khách">

        <div class="mb-4 text-center">
            <small class="text-secondary italic">Đăng ký tài khoản để trải nghiệm dịch vụ đặt vé tốt nhất.</small>
        </div>

        <button type="submit" class="btn btn-danger w-100 fw-bold py-2 shadow">
            TẠO TÀI KHOẢN NGAY <i class="bi bi-arrow-right-short"></i>
        </button>

        <div class="text-center mt-3 small">
            <span class="text-secondary">Đã có tài khoản?</span>
            <a asp-action="DangNhap" class="text-info text-decoration-none">Đăng nhập tại đây</a>
        </div>
    </form>
</div>