@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    // Lấy dữ liệu từ Session
    var role = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
    var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaWeb</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                --netflix-red: #e50914;
                --dark-bg: #0f0f0f;
                --sidebar-bg: #000000;
                --header-h: 70px;
            }

            body {
                background-color: var(--dark-bg);
                color: white;
                margin: 0;
                font-family: 'Segoe UI', Roboto, sans-serif;
                overflow-x: hidden;
            }

            /* --- 1. SIDEBAR BIẾN HÌNH --- */
            .sidebar {
                width: 70px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background-color: var(--sidebar-bg);
                transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                overflow: hidden;
                z-index: 1050;
                border-right: 1px solid #222;
            }

                .sidebar:hover {
                    width: 240px;
                }

                .sidebar .nav-link {
                    color: #aaa;
                    display: flex;
                    align-items: center;
                    white-space: nowrap;
                    padding: 15px 23px;
                    transition: 0.2s;
                    height: 60px;
                    text-decoration: none;
                }

                    .sidebar .nav-link:hover, .sidebar .nav-link.active {
                        color: #fff !important;
                        background-color: var(--netflix-red);
                    }

                    .sidebar .nav-link i {
                        min-width: 30px;
                        font-size: 1.4rem;
                        margin-right: 20px;
                    }

                .sidebar .link-text {
                    opacity: 0;
                    transition: 0.2s;
                    font-weight: 500;
                }

                .sidebar:hover .link-text {
                    opacity: 1;
                }

            /* --- 2. HEADER TỐI GIẢN --- */
            .top-navbar {
                height: var(--header-h);
                background-color: rgba(15, 15, 15, 0.9);
                backdrop-filter: blur(15px);
                position: sticky;
                top: 0;
                z-index: 1000;
                padding: 0 40px;
                border-bottom: 1px solid #222;
                margin-left: 70px;
            }

            .brand-logo {
                font-weight: 800;
                font-size: 1.5rem;
                letter-spacing: 1px;
            }

            /* --- 3. MENU AVATAR & HOVER BRIDGE --- */
            .user-menu-wrapper {
                position: relative;
                padding: 15px 0; /* Tạo vùng đệm để không bị mất Hover */
            }

            .user-trigger {
                display: flex;
                align-items: center;
                cursor: pointer;
            }

            .user-name {
                color: white;
                font-weight: 600;
                font-size: 0.9rem;
                transition: 0.3s;
            }

            .avatar-box {
                width: 38px;
                height: 38px;
                background: var(--netflix-red);
                border-radius: 4px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                border: 1px solid #444;
            }

            .dropdown-box {
                display: none;
                position: absolute;
                right: 0;
                top: 60px;
                background-color: #141414;
                min-width: 190px;
                border: 1px solid #333;
                border-radius: 4px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.7);
            }

                /* Cầu nối tàng hình: Giúp chuột di chuyển mượt mà xuống menu */
                .dropdown-box::before {
                    content: "";
                    position: absolute;
                    top: -15px;
                    left: 0;
                    width: 100%;
                    height: 15px;
                    background: transparent;
                }

            .user-menu-wrapper:hover .dropdown-box {
                display: block;
            }

            .user-menu-wrapper:hover .user-name {
                color: var(--netflix-red);
            }

            .dropdown-box a {
                color: #ccc;
                padding: 12px 18px;
                text-decoration: none;
                display: block;
                font-size: 0.85rem;
                transition: 0.2s;
            }

                .dropdown-box a:hover {
                    background-color: #222;
                    color: white;
                }

            .dropdown-tag {
                padding: 10px 18px;
                color: #666;
                font-size: 0.75rem;
                font-weight: bold;
                text-transform: uppercase;
            }

            /* --- NỘI DUNG --- */
            .main-content {
                margin-left: 70px;
                padding: 30px;
                min-height: 100vh;
            }
    </style>
</head>
<body>

    <nav class="sidebar shadow">
        <div class="d-flex align-items-center justify-content-center" style="height: var(--header-h);">
            <i class="bi bi-film text-danger fs-2"></i>
        </div>

        <div class="d-flex flex-column h-100">
            <div class="nav-links-top">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> <span class="link-text">Trang Chủ</span>
                </a>
                @if (role == "Quản Lý" || role == "Admin")
                {
                    <a class="nav-link" asp-controller="Home" asp-action="AdminPhim">
                        <i class="bi bi-shield-lock"></i> <span class="link-text">Quản Trị</span>
                    </a>
                    <a class="nav-link" asp-controller="Home" asp-action="BaoCao">
                        <i class="bi bi-bar-chart-line"></i> <span class="link-text">Thống Kê</span>
                    </a>
                }
                @if (role == "Khách")
                {
                    <a class="nav-link" asp-controller="Home" asp-action="LichSu">
                        <i class="bi bi-ticket-perforated"></i> <span class="link-text">Vé Của Tôi</span>
                    </a>
                }
            </div>

            <div class="mt-auto mb-4 border-top border-secondary border-opacity-25">
                <a class="nav-link" asp-controller="Home" asp-action="AboutUs">
                    <i class="bi bi-info-circle text-info"></i>
                    <span class="link-text">Về Chúng Tôi</span>
                </a>
            </div>
        </div>
    </nav>

    <header class="top-navbar d-flex align-items-center justify-content-between">
        <div class="brand-logo">
            <span class="text-danger">THE</span><span class="text-white">CINEMA</span>
        </div>

        <div class="auth-area">
            @if (string.IsNullOrEmpty(role))
            {
                <a asp-action="DangKy" class="btn btn-link text-white text-decoration-none me-3 fw-bold small">Đăng Ký</a>
                <a asp-action="DangNhap" class="btn btn-danger px-4 rounded-pill fw-bold btn-sm shadow">Đăng Nhập</a>
            }
            else
            {
                <div class="user-menu-wrapper">
                    <div class="user-trigger">
                        <span class="user-name me-3">@userName</span>
                        <div class="avatar-box">
                            <i class="bi bi-person-fill"></i>
                        </div>
                    </div>

                    <div class="dropdown-box shadow-lg">
                        <div class="dropdown-tag">Vai trò: @role</div>
                        <hr class="m-0 border-secondary">
                        <a asp-action="SuaThongTin">
                            <i class="bi bi-person-gear me-2"></i>Sửa hồ sơ
                        </a>
                        <a asp-action="DangXuat" class="text-danger">
                            <i class="bi bi-box-arrow-left me-2"></i>Đăng xuất
                        </a>
                    </div>
                </div>
            }
        </div>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>